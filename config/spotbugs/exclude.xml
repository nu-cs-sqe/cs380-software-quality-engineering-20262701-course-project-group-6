<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Our standard requires constructors to validate their arguments and throw IllegalArgumentException,
         which this finalizer-attack warning flags on every validating constructor. See docs/coding-standard.md. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- Dice keeps the Random it is given on purpose: the coding standard says to inject random dependencies so tests
         can stub them, and Dice never exposes it. -->
    <Match>
        <Class name="domain.Dice"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
